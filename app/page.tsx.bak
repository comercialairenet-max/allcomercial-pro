function getCategoryCardContent(slug: string) {
  const meta = categoriasMeta[slug as keyof typeof categoriasMeta];
  const products = getProductosPorCategoria(slug as keyof typeof categoriasMeta);
  const featured = products.filter((p) => p.destacado);
  const lines = Array.from(new Set(products.map((p) => p.linea).filter(Boolean)));
  const ui = categoryCommercialContent[slug];
  const Icon = getCategoryIcon(slug);

  return {
    slug,
    nombre: ui?.title ?? meta?.nombre ?? formatLabel(slug),
    descripcion:
      ui?.description ??
      meta?.descripcion ??
      "CategorÃ­a industrial organizada para facilitar la bÃºsqueda y cotizaciÃ³n.",
    bullets: ui?.bullets ?? [],
    total: products.length,
    destacados: featured.length,
    lineas: lines.length,
    priority: ui?.priority ?? false,
    icon: Icon,
  };
}

