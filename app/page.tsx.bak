function formatLabel(text: string) {
  return text
    .replace(/-/g, " ")
    .replace(/\b\w/g, (char) => char.toUpperCase());
}

function getNivelLabel(nivel: string) {
  const map: Record<string, string> = {
    entrada: "Entrada",
    estandar: "EstÃ¡ndar",
    "alto-desempeno": "Alto desempeÃ±o",
    critico: "CrÃ­tico",
    especializado: "Especializado",
    proyecto: "Proyecto",
  };

  return map[nivel] ?? formatLabel(nivel);
}

function getCategoryIcon(slug: string) {
  const map: Record<string, React.ComponentType<{ className?: string }>> = {
    "filtracion-industrial": Filter,
    "ventilacion-industrial": Fan,
    "sistemas-de-aire-comprimido": Wind,
    "cabinas-de-pintura": PaintBucket,
    "equipos-para-reparacion-de-carrocerias": Wrench,
    "lamparas-de-secado-ir": Lightbulb,
  };

  return map[slug] ?? Building2;
}

